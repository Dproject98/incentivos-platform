# ─────────────────────────────────────────────────────────────────────────────
# incentivos-app — Variables de entorno para servidor casero
# Copia como .env.production y rellena todos los valores
# NUNCA subas este archivo con valores reales a git
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (PostgreSQL local en Docker) ────────────────────────────────
# Genera una contraseña fuerte: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_PASSWORD_FUERTE

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=GENERA_CON_openssl_rand_-base64_32
# URL pública de tu aplicación (con https)
NEXTAUTH_URL=https://tudominio.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Crea cuenta en resend.com — gratis hasta 3.000 emails/mes
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXX

# ── WhatsApp / Twilio (opcional) ──────────────────────────────────────────────
# Deja vacío para deshabilitar WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Stripe ────────────────────────────────────────────────────────────────────
# Usa claves LIVE en producción (no test)
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXX
